# Copia este archivo como .env y llena los valores reales
# NUNCA subas el archivo .env a GitHub

# Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE_AQUI

# Cuenta de servicio del terminal POS (crear en Supabase Dashboard → Authentication → Users)
# Email sugerido: pos-terminal@elcafedelconstructor.com.mx
VITE_POS_EMAIL=pos-terminal@tudominio.com
VITE_POS_PASSWORD=

# MercadoPago Point Terminal
VITE_MP_ACCESS_TOKEN=
VITE_MP_DEVICE_ID=

# Claude AI — Recuperación automática de errores
# Obtener en: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# Telegram Bot — Control remoto del POS desde el celular del dueño
# Crear bot en @BotFather, obtener chat_id enviando un mensaje al bot
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_ADMIN_CHAT_ID=
